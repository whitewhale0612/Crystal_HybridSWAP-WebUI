#!/sbin/sh

umask 022

ui_print() {
  echo "$1"
}

abort() {
  ui_print "$1"
  exit 1
}

OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null || true

if [ -f /data/adb/magisk/util_functions.sh ]; then
  . /data/adb/magisk/util_functions.sh
  [ "$MAGISK_VER_CODE" -lt 20400 ] &&
    abort "! Please install Magisk v20.4+"
  install_module
  exit 0
fi

BB=/data/adb/ksu/bin/busybox
[ -x "$BB" ] || BB=busybox
"$BB" true >/dev/null 2>&1 || abort "! KernelSU busybox not found"

[ -f "$ZIPFILE" ] || abort "! ZIPFILE is not available"
[ -d /data/adb ] || abort "! /data/adb is not available"

no_slash_tail() {
  [ -n "$1" ] || return 1
  case "$1" in
    */*) return 1 ;;
  esac
  return 0
}

is_runtime_webroot_entry() {
  rel="$1"
  case "$rel" in
    index.html | config.json | launcher.png | vendor/preact.mjs)
      return 0
      ;;
    css/*.css)
      no_slash_tail "${rel#css/}"
      return $?
      ;;
    js/components/*.js)
      no_slash_tail "${rel#js/components/}"
      return $?
      ;;
    js/pages/*.js)
      no_slash_tail "${rel#js/pages/}"
      return $?
      ;;
    js/*.js)
      no_slash_tail "${rel#js/}"
      return $?
      ;;
  esac
  return 1
}

is_allowed_zip_entry() {
  entry="$1"
  case "$entry" in
    module.prop | launcher.png | skip_mount | post-fs-data.sh | service.sh | \
      boot-completed.sh | daemon.sh | uninstall.sh | \
      bin/chswapctl | customize.sh | \
      META-INF/com/google/android/update-binary | \
      META-INF/com/google/android/updater-script)
      return 0
      ;;
    webroot/*)
      is_runtime_webroot_entry "${entry#webroot/}"
      return $?
      ;;
  esac
  return 1
}

zip_entries() {
  "$BB" unzip -lq "$ZIPFILE" | "$BB" awk '
    /^ *-+/ {
      if (body) {
        exit
      }
      body = 1
      next
    }
    body {
      name = substr($0, 31)
      sub(/^ +/, "", name)
      if (name != "") {
        print name
      }
    }
  '
}

validate_zip_entry() {
  entry="$1"
  case "$entry" in
    "" | /* | *\\* | "." | "./"* | */"." | */"./"* | \
      ".." | "../"* | */".." | */"../"*)
      abort "! Unsafe zip entry: $entry"
      ;;
    */)
      abort "! Directory zip entry is not allowed: $entry"
      ;;
  esac
  is_allowed_zip_entry "$entry" ||
    abort "! Unexpected zip entry: $entry"
}

validate_zip() {
  entries="$1"
  [ -n "$entries" ] || abort "! Module zip is empty"
  while IFS= read -r entry; do
    validate_zip_entry "$entry"
  done <<EOF
$entries
EOF
  for required in module.prop launcher.png bin/chswapctl customize.sh \
    post-fs-data.sh service.sh boot-completed.sh daemon.sh uninstall.sh \
    webroot/config.json webroot/launcher.png; do
    printf '%s\n' "$entries" | "$BB" grep -qx "$required" ||
      abort "! Module zip missing $required"
  done
}

"$BB" unzip -tq "$ZIPFILE" >/dev/null ||
  abort "! Module zip integrity check failed"
ZIP_ENTRIES="$(zip_entries)"
validate_zip "$ZIP_ENTRIES"

ID="$("$BB" unzip -p "$ZIPFILE" module.prop |
  "$BB" awk -F= '$1 == "id" { print $2; exit }')"

[ -n "$ID" ] || abort "! module.prop id not found"

case "$ID" in
  *[!A-Za-z0-9._-]*)
    abort "! Unsafe module id: $ID"
    ;;
esac

MODPATH="/data/adb/modules_update/$ID"

ui_print "- Installing $ID"
"$BB" rm -rf "$MODPATH" || abort "! Failed to clean module path"
"$BB" mkdir -p "$MODPATH" || abort "! Failed to create module path"
"$BB" unzip -o "$ZIPFILE" -d "$MODPATH" >/dev/null ||
  abort "! Failed to extract module zip"

if "$BB" find "$MODPATH" -type l 2>/dev/null | "$BB" grep -q .; then
  "$BB" rm -rf "$MODPATH"
  abort "! Module zip extracted symlinks"
fi

"$BB" rm -rf \
  "$MODPATH/META-INF" \
  "$MODPATH/data" \
  "$MODPATH/logs" \
  "$MODPATH/diagnostics" \
  "$MODPATH/state"

ARCH="$("$BB" uname -m 2>/dev/null || echo unknown)"
case "$ARCH" in
  aarch64 | arm64 | arm64-v8a)
    ARCH=arm64
    ;;
esac

export ARCH MODPATH ZIPFILE OUTFD

[ -f "$MODPATH/customize.sh" ] && . "$MODPATH/customize.sh"

"$BB" rm -f "$MODPATH/customize.sh" "$MODPATH/README.md"
"$BB" mkdir -p "/data/adb/modules/$ID" 2>/dev/null || true
"$BB" cp -af "$MODPATH/module.prop" "/data/adb/modules/$ID/module.prop" \
  2>/dev/null || true
: >"/data/adb/modules/$ID/update" 2>/dev/null || true

ui_print "- Done"
ui_print "- Reboot to activate the module"
exit 0
